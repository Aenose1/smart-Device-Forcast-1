# Copy to .env and fill in. NEVER commit .env.
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database (PostgreSQL recommended) ---
POSTGRES_USER=sdf_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sdf
DATABASE_URL=postgresql+psycopg2://sdf_user:change-me-strong-password@localhost:5432/sdf

# --- Auth ---
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=480
COOKIE_SECURE=false          # set true when served over HTTPS

# --- Web ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
MAX_UPLOAD_MB=10
RATE_LIMIT_ENABLED=true

# --- Forecasting ---
MAX_FORECAST_YEARS=5
DEFAULT_FORECAST_YEARS=3
MODELS_DIR=models

# --- Bootstrap (optional) ---
# Creates this admin on first start if it does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Loads the clearly-labelled DEMO dataset in data/sample when the catalogue is empty.
SEED_SAMPLE_DATA=false
