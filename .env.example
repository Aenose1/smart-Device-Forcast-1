# Copy to .env and fill in. NEVER commit .env.
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database ---
# LOCAL RUN (default): a single-file SQLite database, nothing to install. If you copy the PostgreSQL URL below
# without running PostgreSQL, every sign-in / registration fails with "database is temporarily unavailable".
DATABASE_URL=sqlite:///./dev.db
# DOCKER / PRODUCTION (PostgreSQL): docker-compose builds DATABASE_URL itself from these three values.
POSTGRES_USER=sdf_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sdf
# Manual PostgreSQL URL (only if you run PostgreSQL yourself):
# DATABASE_URL=postgresql+psycopg2://sdf_user:change-me-strong-password@localhost:5432/sdf

# --- Auth ---
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=480
COOKIE_SECURE=false          # keep false for http://localhost; true ONLY behind HTTPS (otherwise the browser drops the login cookie)

# --- Web ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
MAX_UPLOAD_MB=10
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10          # sign-in attempts per minute per IP
REGISTER_RATE_LIMIT=20       # registrations per hour per IP

# --- Forecasting ---
MAX_FORECAST_YEARS=5
DEFAULT_FORECAST_YEARS=3
MODELS_DIR=models

# --- Bootstrap (optional) ---
# Creates this admin on first start if it does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Loads the clearly-labelled DEMO dataset in data/sample when the catalogue is empty.
SEED_SAMPLE_DATA=true         # loads the clearly-labelled synthetic DEMO catalogue on first start (set false for real data only)
